rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create, read, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.keys().hasOnly(["displayName", "updatedAt"]);
      allow delete: if false;
    }

    match /scans/{scanId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.scanId == scanId
        && request.resource.data.keys().hasOnly([
          "scanId", "ownerUid", "displayName", "productCategory", "status",
          "currentPanel", "imageUrl", "createdAt", "updatedAt"
        ]);
      allow read, update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /events/{eventId} {
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/scans/$(scanId)).data.ownerUid == request.auth.uid;
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/scans/$(scanId)).data.ownerUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /sharedReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reportId == reportId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.scanId is string
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.keys().hasOnly([
          "reportId", "code", "ownerUid", "scanId", "displayName", "panel", "status",
          "qualityStatus", "qualityIssues", "ocrStatus", "ocrPreview",
          "createdAt"
        ]);
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
